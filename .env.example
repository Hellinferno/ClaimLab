# ClaimLab Environment Configuration

APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/claimlab.db
DATA_DIR=./data
SESSION_SECRET=dev-secret-change-in-production-min-32-chars-long!

# Meta Model API Configuration
MODEL_MODE=fixture
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Web research for the live tutor (TinyFish search + fetch; free daily allowance).
# Create a key at https://agent.tinyfish.ai/api-keys. Empty disables web tools.
TINYFISH_API_KEY=

# Pricing & Budget Configuration
MODEL_INPUT_USD_PER_MILLION=0.30
MODEL_OUTPUT_USD_PER_MILLION=1.20
APP_AI_BUDGET_USD=10.00

# Container Runtime Configuration (when Docker daemon is enabled)
RUNNER_IMAGE=claimlab-runner:latest
PDF_PARSER_IMAGE=claimlab-parser:latest
RUNNER_BACKEND=local

# Agent-written experiment sandbox (create with: python -m claimlab.scripts.setup_sandbox)
SANDBOX_VENV_DIR=./.sandbox-venv
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=768
